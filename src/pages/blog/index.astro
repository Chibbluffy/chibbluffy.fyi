---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout title="blog">
  <section class="hero">
    <h1>blog</h1>
  </section>

  {posts.length === 0 ? (
    <p class="empty">nothing here yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.id}`}>
            <span class="title">{post.data.title}</span>
            <span class="meta">
              <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
              {post.data.tags && post.data.tags.map(t => <span class="tag">{t}</span>)}
            </span>
            <span class="desc">{post.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Layout>

<style>
  .hero {
    padding: 5rem 0 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    margin-bottom: 4rem;
  }

  .post-list li {
    border-bottom: 1px solid var(--border);
  }

  .post-list a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 0;
    color: var(--text);
    text-decoration: none;
  }

  .post-list a:hover .title {
    color: var(--accent);
  }

  .title {
    font-size: 1rem;
    font-weight: 600;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    background: var(--accent-dim);
    color: var(--accent);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .desc {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .empty {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
</style>
