---
import Layout from '../layouts/Layout.astro';

const online = [
  {
    label: 'GitHub',
    handle: '@Chibbluffy',
    url: 'https://github.com/Chibbluffy',
  },
  {
    label: 'Discord',
    handle: 'Chibbluffy',
    url: null,
  },
  {
    label: 'Email',
    handle: 'chibbluffy@protonmail.com',
    url: 'mailto:chibbluffy@protonmail.com'
  },
];


const sites = [
  {
    label: 'boop.fish',
    note: 'BDO guild site',
    url: 'https://boop.fish',
  },
  {
    label: 'BYMR Maproom Viewer — MR3',
    note: 'for Map Room 3 accounts',
    url: 'https://bymr-maproom3-viewer.chibbluffy.fyi',
  },
  {
    label: 'BYMR Maproom Viewer — MR2',
    note: 'for Map Room 2 accounts',
    url: 'https://bymr-maproom2-viewer.chibbluffy.fyi',
  },
  {
    label: 'Credit Card Rewards Quick Reference',
    note: 'Beta: local in browser app to pin credit card bonus information for quick reference',
    url: 'https://cc-rewards.chibbluffy.fyi',
  },
  {
    label: 'Divvy Up',
    note: 'Split payment calculator, shareable links, no account needed',
    url: 'https://divvy.chibbluffy.fyi',
  },
  {
    label: 'watch.chibbluffy.fyi',
    note: 'Self-hosted WebRTC virtual browser (neko fork) with image sharing and Giphy chat',
    url: 'https://watch.chibbluffy.fyi',
  },
];
---

<Layout title="links">
  <section class="hero">
    <h1>links</h1>
  </section>

  <div class="sections">
    <section>
      <h2>find me</h2>
      <ul class="link-list">
        {online.map(l => (
          <li>
            <span class="link-label">{l.label}</span>
            {l.url
              ? <a href={l.url} target="_blank" rel="noopener">{l.handle}</a>
              : <span class="handle">{l.handle}</span>
            }
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>my sites</h2>
      <ul class="link-list">
        {sites.map(l => (
          <li>
            <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
            {l.note && <span class="note">— {l.note}</span>}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<style>
  .hero {
    padding: 5rem 0 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .link-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.95rem;
  }

  .link-label {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    min-width: 5rem;
  }

  .handle {
    color: var(--text);
  }

  .note {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

</style>
