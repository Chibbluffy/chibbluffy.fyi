---
import Layout from '../layouts/Layout.astro';

const online = [
  {
    label: 'GitHub',
    handle: '@Chibbluffy',
    url: 'https://github.com/Chibbluffy',
  },
  {
    label: 'Discord',
    handle: 'Chibbluffy',
    url: null,
  },
  {
    label: 'Email',
    handle: 'chibbluffy@protonmail.com',
    url: 'mailto:chibbluffy@protonmail.com'
  },
];

const shortcuts = [
  // { label: 'Example', note: 'quick description', url: 'https://example.com' },
];

const tools = [
  { label: 'Home Assistant', note: '', url: 'https://.com' },
  { label: 'Hello Willow Github', note: 'Voice Assistant', url: 'https://github.com/HeyWillow/willow' },
  { label: 'Rekt.network', note: 'cyberpunk radio; Includes chat', url: 'https://rekt.network/' },
  { label: 'Tune My Music', note: 'playlist transfer tool', url: 'https://tunemymusic.com/transfer' },
  { label: 'Credit Card Points Transfer', note: 'Updated page with transfer bonuses', url: 'https://travel-on-points.com/current-point-transfer-bonuses' },
  { label: 'Equinox.space', note: 'Browser game', url: 'https://equinox.space' },
  { label: 'Ratty-term', note: 'GPU Rendered terminal emulator with inline 3D graphics', url: 'https://ratty-term.org' },
  { label: 'GitNexus', note: 'Explore github repo as a knowledge graph. Good for RAG and AI agents', url: 'https://gitnexus.vercel.app' },
  { label: 'GitNexus Source', note: 'Explore github repo as a knowledge graph. Good for RAG and AI agents', url: 'https://github.com/abhigyanpatwari/GitNexus' },
  { label: 'MVIDIA', note: 'Game of how to build a GPU', url: 'https://jaso1024.com/mvidia' },
  // { label: 'Example', note: 'what', url: 'https://' },
];

const sites = [
  {
    label: 'boop.fish',
    note: 'BDO guild site',
    url: 'https://boop.fish',
  },
  {
    label: 'BYMR Maproom Viewer — MR3',
    note: 'for Map Room 3 accounts',
    url: 'https://bymr-maproom3-viewer.chibbluffy.fyi',
  },
  {
    label: 'BYMR Maproom Viewer — MR2',
    note: 'for Map Room 2 accounts',
    url: 'https://bymr-maproom2-viewer.chibbluffy.fyi',
  },
  {
    label: 'Credit Card Rewards Quick Reference',
    note: 'Beta: local in browser app to pin credit card bonus information for quick reference',
    url: 'https://cc-rewards.chibbluffy.fyi',
  },
];
---

<Layout title="links">
  <section class="hero">
    <h1>links</h1>
  </section>

  <div class="sections">
    <section>
      <h2>find me</h2>
      <ul class="link-list">
        {online.map(l => (
          <li>
            <span class="link-label">{l.label}</span>
            {l.url
              ? <a href={l.url} target="_blank" rel="noopener">{l.handle}</a>
              : <span class="handle">{l.handle}</span>
            }
          </li>
        ))}
      </ul>
    </section>

    {shortcuts.length > 0 && (
      <section>
        <h2>shortcuts</h2>
        <ul class="link-list">
          {shortcuts.map(l => (
            <li>
              <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
              {l.note && <span class="note">— {l.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {tools.length > 0 && (
      <section>
        <h2>tools &amp; resources</h2>
        <input
          type="text"
          id="tools-search"
          placeholder="search..."
          autocomplete="off"
          spellcheck="false"
        />
        <ul class="link-list" id="tools-list">
          {tools.map(l => (
            <li data-search={`${l.label} ${l.note ?? ''}`.toLowerCase()}>
              <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
              {l.note && <span class="note">— {l.note}</span>}
            </li>
          ))}
        </ul>
        <p class="no-results" id="tools-no-results">no results</p>
      </section>
    )}

    <section>
      <h2>my sites</h2>
      <ul class="link-list">
        {sites.map(l => (
          <li>
            <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
            {l.note && <span class="note">— {l.note}</span>}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<style>
  .hero {
    padding: 5rem 0 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .sections {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .link-list li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.95rem;
  }

  .link-label {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    min-width: 5rem;
  }

  .handle {
    color: var(--text);
  }

  .note {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  #tools-search {
    display: block;
    width: 100%;
    max-width: 20rem;
    margin-bottom: 1rem;
    padding: 0.35rem 0.6rem;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    outline: none;
  }

  #tools-search:focus {
    border-color: var(--text-muted);
  }

  #tools-search::placeholder {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .no-results {
    display: none;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }
</style>

<script>
  const input = document.getElementById('tools-search') as HTMLInputElement | null;
  const list = document.getElementById('tools-list');
  const noResults = document.getElementById('tools-no-results');

  input?.addEventListener('input', () => {
    const query = input.value.toLowerCase().trim();
    const items = list?.querySelectorAll<HTMLLIElement>('li') ?? [];
    let visible = 0;

    for (const item of items) {
      const match = !query || item.dataset.search?.includes(query);
      item.style.display = match ? '' : 'none';
      if (match) visible++;
    }

    if (noResults) {
      noResults.style.display = visible === 0 && query ? 'block' : 'none';
    }
  });
</script>
