---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, categories } from '../data/projects';
import type { Project } from '../data/projects';

const grouped = Object.entries(categories).reduce((acc, [key]) => {
  const cat = key as Project['category'];
  const items = projects.filter(p => p.category === cat);
  if (items.length > 0) acc.push([cat, items]);
  return acc;
}, [] as [Project['category'], Project[]][]);
---

<Layout>
  <section class="hero">
    <h1>Hiya, i'm <span class="accent">chibbluffy</span></h1>
    <p class="tagline">I like to make things and mess around with stuff i find interesting.</p>
  </section>

  <section id="projects">
    {grouped.map(([cat, items]) => (
      <div class="group">
        <h2>{categories[cat]}</h2>
        <div class="grid">
          {items.map(p => <ProjectCard project={p} />)}
        </div>
      </div>
    ))}
  </section>
</Layout>

<style>
  .hero {
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .accent {
    color: var(--accent);
  }

  .tagline {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 480px;
  }

  #projects {
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .group h2 {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
</style>
